# Generated by tools/generate_configs.py — DO NOT EDIT
# ibctl configuration file
# 
# Precedence (highest to lowest):
#   1. Environment variables (override everything)
#   2. This config file
#   3. Built-in defaults
# 
# Passwords and TOTP secrets are env-var only (with _FILE support).
# They are never read from this file to prevent committing secrets.
# 
# Copy this file to ibctl.toml and edit as needed.

[auth]
# IB login username (env: TWS_USERID)
tws_userid = ""
# Trading mode: live | paper | both (env: TRADING_MODE)
trading_mode = "paper"

[auth.paper]
# Paper account username, only needed for dual mode (env: TWS_USERID_PAPER)
tws_userid = ""


[twofa]
# TOTP provider: oathtool | builtin (env: TOTP_PROVIDER)
provider = "oathtool"
# Action on 2FA timeout: restart | exit (env: TWOFA_TIMEOUT_ACTION)
timeout_action = "restart"
# Seconds to wait for 2FA completion (env: TWOFA_EXIT_INTERVAL)
exit_interval = 180

[twofa.backoff]
# After this many consecutive 2FA timeouts, stop the tight restart loop
# and enter WaitingForHitl2fa. 0 = disabled (loop forever).
max_immediate_attempts = 3
# "restart_then_hitl" | "restart_forever" | "hitl_immediately"
on_timeout = "restart_then_hitl"
# HITL strategy: "disabled" | "periodic" | "ntfy_callback" | "both"
strategy = "periodic"
# Retry cadence in minutes; list traversed then held at last value
intervals_minutes = [60]
# ntfy action URL validity window (1..=168 hours)
callback_valid_hours = 12
# "any_reach" | "stable" — when to reset the attempt counter
counter_reset = "any_reach"
# seconds Connected must persist under counter_reset=stable
stable_secs = 300
# true: cold restart always interrupts HITL; false: defers
cold_restart_preempts_hitl = true
# retries for initial ntfy send failure (only with ntfy_callback/both)
ntfy_send_retries = 1

# HMAC-SHA256 key for signing ntfy action URLs. Env only — never in TOML.
# # Env: IBCTL_NTFY_ACTION_SIGNING_KEY

[gateway]
# Path to TWS/Gateway installation (env: TWS_PATH)
tws_path = "/home/ibgateway/Jts"
# Settings storage path, defaults to tws_path (env: TWS_SETTINGS_PATH)
tws_settings_path = ""
# Gateway version, auto-detected if empty (env: TWS_MAJOR_VRSN)
tws_major_vrsn = ""
# JVM heap size in MB (env: JAVA_HEAP_SIZE)
java_heap_size = 768
# Program type: gateway | tws (env: GATEWAY_OR_TWS)
gateway_or_tws = "gateway"

[session]
# Session conflict action: primary | secondary | primaryoverride (env: IBCTL_SESSION_ACTION)
action = "primary"
# Incoming API connections: accept | reject | manual (env: IBCTL_ACCEPT_INCOMING)
accept_incoming = "accept"

[command_server]
# Enable IBC-compatible TCP command server
enabled = false
# TCP port (env: IBCTL_COMMAND_PORT)
port = 7462
# Bind address
bind_address = "0.0.0.0"
# IP allow-list for command access (env: IBCTL_CONTROL_FROM, comma-separated)
control_from = ["127.0.0.1"]

[agent]
# Unix domain socket path for Rust<->Java agent IPC (env: IBCTL_AGENT_SOCKET)
socket_path = "/tmp/ibctl.sock"

[ib_status]
# When IBSTATUS=unavailable arrives, should ibctl kick a Connected session?
# Default false — IBSTATUS gates login retry, not active sessions.
kick_active_session = false

[logging]
# Log level: debug | info | warn | error (env: IBCTL_LOG_LEVEL)
level = "info"

[timing]
# TCP probe interval to Gateway's API port during post-auth states.
# 0 = disabled (rely on label probe only). (env: IBCTL_API_PORT_PROBE_INTERVAL_SECS)
api_port_probe_interval_secs = 5
# Consecutive TCP probe failures before firing ApiPortListenerLost revocation.
# (env: IBCTL_API_PORT_PROBE_FAILS_BEFORE_REVOKE)
api_port_probe_fails_before_revoke = 3
