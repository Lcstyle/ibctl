/// ibctl configuration schema.
///
/// This is the canonical type definition for the ibctl deployment model.
/// All generated config artifacts (TOML, Compose, .env) derive from this schema.
///
/// The runtime layer mirrors ibctl/src/config.rs structs exactly — the generated
/// TOML must satisfy the Rust parser.
module ibctl.types

// --- Module-level properties (amendable by base.pkl and profiles) ---

/// Human-readable project name
name: String = "ibctl"

/// Profile identifier (e.g., "live", "both", "dashboard")
profile: String = "base"

/// High-level deployment settings
deployment: Deployment = new Deployment {}

/// Runtime config — maps to ibctl.toml sections consumed by Rust
runtime: RuntimeConfig = new RuntimeConfig {}

/// Container/image settings for Docker deployment
container: ContainerConfig = new ContainerConfig {}

/// Docker Compose service definition shape
compose: ComposeConfig = new ComposeConfig {}

// --- Enums ---

typealias TradingMode = "live"|"paper"|"both"
typealias TotpProvider = "oathtool"|"builtin"
typealias TwoFaTimeoutAction = "restart"|"exit"
typealias GatewayProgram = "gateway"|"tws"
typealias SessionAction = "primary"|"secondary"|"primaryoverride"
typealias AcceptIncoming = "accept"|"reject"|"manual"
typealias SiteRole = "primary"|"standby"
typealias LogLevel = "debug"|"info"|"warn"|"error"

// --- Deployment Layer ---

/// High-level deployment identity — what kind of system is this?
class Deployment {
  /// Trading mode for the deployment: live | paper | both. Propagated by base.pkl
  /// into `runtime.auth.tradingMode` — the value rendered under `[auth].trading_mode`.
  /// @env TRADING_MODE
  tradingMode: TradingMode = "live"

  /// Site role for HA topologies: primary | standby. Rendered under `[site].role`.
  /// @env IBCTL_SITE_ROLE
  siteRole: SiteRole = "primary"

  /// Auto-launch Gateway on container startup. Rendered under `[site].auto_launch`.
  /// @env IBCTL_AUTO_LAUNCH
  autoLaunch: Boolean = true

  /// IANA timezone name for the container. Consumed by `docker/entrypoint.sh`
  /// via env — does NOT render into TOML.
  timezone: String = "America/New_York"
}

// --- Runtime Layer (mirrors config.rs) ---

/// Runtime config tree — mirrors ibctl/src/config.rs::Config. Unknown top-level
/// sections are rejected by Pydantic preflight and silently ignored by Rust's
/// serde parser (serde(flatten) semantics on Config).
class RuntimeConfig {
  /// IB login credentials. Passwords and TOTP secrets are env-only; only tws_userid
  /// and trading_mode appear in generated TOML.
  auth: AuthConfig = new AuthConfig {}

  /// Two-factor authentication (TOTP) settings and human-in-the-loop backoff policy.
  twofa: TwoFaConfig = new TwoFaConfig {}

  /// Gateway/TWS installation paths, JVM tuning, and API/socat port assignments.
  gateway: GatewayConfig = new GatewayConfig {}

  /// Session conflict handling and scheduled cold-restart window.
  session: SessionConfig = new SessionConfig {}

  /// IBC-compatible TCP command server (required for dashboard control).
  commandServer: CommandServerConfig = new CommandServerConfig {}

  /// Rust↔Java agent IPC settings (Unix domain socket).
  agent: AgentConfig = new AgentConfig {}

  /// Web dashboard settings (consumed by entrypoint + FastAPI, not by Rust directly).
  /// OAuth client secrets, bearer tokens are env-only.
  dashboard: DashboardConfig = new DashboardConfig {}

  /// IB system status scraper settings (consumed by dashboard daemon).
  ibSystemStatus: IbSystemStatusConfig = new IbSystemStatusConfig {}

  /// ibctl-side policy for IBSTATUS pushes (consumed by ibctl state machine).
  /// Separate from ibSystemStatus which is the dashboard-side scraper.
  ibStatus: IbStatusConfig = new IbStatusConfig {}

  /// Log level, log directory, and futures-session log rotation.
  logging: LoggingConfig = new LoggingConfig {}

  /// Timing knobs for UI automation, retry cadence, and the three-phase reconnect
  /// recovery coordinator.
  timing: TimingConfig = new TimingConfig {}
}

/// Auth config. Passwords are env-only (TWS_PASSWORD / TWS_PASSWORD_FILE for live;
/// TWS_PASSWORD_PAPER / TWS_PASSWORD_PAPER_FILE for paper) — never in TOML.
/// Only tws_userid and trading_mode appear in generated TOML.
class AuthConfig {
  /// IB login username. Set via env var, not in TOML. Must be empty (env-only)
  /// or an alphanumeric IB username.
  /// @env TWS_USERID
  twsUserid: String(matches(Regex("^[a-zA-Z0-9_]*$"))) = ""

  /// Trading mode: live | paper | both. Overrides deployment.tradingMode when
  /// set directly on runtime.auth.
  /// @env TRADING_MODE
  tradingMode: TradingMode = "paper"

  /// Paper account sub-config, only needed for dual mode (trading_mode=both).
  paper: PaperAuthConfig = new PaperAuthConfig {}
}

class PaperAuthConfig {
  /// Paper account username. Set via env var, not in TOML. Must be empty
  /// (env-only) or an alphanumeric IB username.
  /// @env TWS_USERID_PAPER
  twsUserid: String(matches(Regex("^[a-zA-Z0-9_]*$"))) = ""
}

/// Two-factor authentication settings.
class TwoFaConfig {
  /// Name of the env var holding the TOTP shared-key value used to generate 2FA codes.
  /// Field stores the *env var name*, never the credential itself.
  /// This is the *name* of an env var — not the secret value itself.
  secretEnv: String(matches(Regex("^[A-Z][A-Z0-9_]*$"))) = "TWOFACTOR_CODE"

  /// TOTP provider: "oathtool" (shells out) or "builtin" (not yet implemented).
  /// @env TOTP_PROVIDER
  provider: TotpProvider = "oathtool"

  /// Action on 2FA timeout: "restart" (re-login) or "exit" (shutdown ibctl).
  /// @env TWOFA_TIMEOUT_ACTION
  timeoutAction: TwoFaTimeoutAction = "restart"

  /// Max seconds to wait for 2FA approval before firing timeoutAction.
  /// Rust code default is 180; base.pkl overrides to 120 for Docker deployment.
  /// @env TWOFA_EXIT_INTERVAL
  exitInterval: UInt = 180

  /// 2FA device name for the device selection dialog. Empty = skip selection.
  /// @env TWOFA_DEVICE
  device: String = ""

  /// Force re-login even after a 2FA timeout — overrides timeoutAction=restart
  /// semantics when set.
  /// @env RELOGIN_AFTER_TWOFA_TIMEOUT
  reloginAfterTimeout: Boolean = false

  /// Human-in-the-loop 2FA backoff policy.
  backoff: TwoFaBackoffConfig = new TwoFaBackoffConfig {}
}

/// Policy for stopping the tight 2FA-restart loop after repeated failures
/// (operator asleep, unavailable). After `maxImmediateAttempts` consecutive
/// 2FA timeouts, ibctl enters WaitingForHitl2fa — a cooperative state that
/// either auto-retries on a schedule, waits for an operator ntfy callback,
/// or both. Prevents overnight IB Key prompt spam.
///
/// HMAC-SHA256 signing key for ntfy action URLs is env-only:
/// IBCTL_NTFY_ACTION_SIGNING_KEY (never in TOML).
class TwoFaBackoffConfig {
  /// After this many consecutive 2FA timeouts, stop the tight restart loop and
  /// enter WaitingForHitl2fa. 0 = disabled (legacy behavior: loop forever).
  /// @env IBCTL_TWOFA_MAX_IMMEDIATE_ATTEMPTS
  maxImmediateAttempts: UInt = 3

  /// What to do when twofa.exitInterval fires.
  ///   "restart_then_hitl" — kill JVM, relaunch, count attempt; hit HITL on exhaustion (default)
  ///   "restart_forever"   — legacy pre-HITL behavior (never stop)
  ///   "hitl_immediately"  — first timeout goes straight to HITL (no restarts at all)
  /// @env IBCTL_TWOFA_ON_TIMEOUT
  onTimeout: TwoFaOnTimeout = "restart_then_hitl"

  /// HITL resume strategy: "disabled" | "periodic" | "ntfy_callback" | "both".
  /// "disabled" = stay in HITL forever (dashboard still reflects state; operator
  /// must send HITL_RESUME manually via dashboard).
  /// @env IBCTL_TWOFA_STRATEGY
  strategy: HitlStrategy = "periodic"

  /// Retry cadence in minutes for periodic / both. Single value = constant.
  /// List = traverse then hold at last element. Must be non-empty for non-
  /// disabled strategies that include a timer.
  intervalsMinutes: Listing<UInt> = new Listing { 60 }

  /// Hours the signed ntfy-action URL stays valid — one-shot, redeemed on
  /// first successful click. Range 1..=168 (one week ceiling).
  /// @env IBCTL_TWOFA_CALLBACK_VALID_HOURS
  callbackValidHours: UInt = 12

  /// Counter-reset policy after a successful reach of Connected.
  ///   "any_reach" — reset as soon as Connected (default)
  ///   "stable"    — require Connected sustained for stableSecs before reset
  /// @env IBCTL_TWOFA_COUNTER_RESET
  counterReset: CounterResetScope = "any_reach"

  /// Seconds Connected must persist before resetting the attempt counter
  /// when counterReset = "stable". Ignored for "any_reach".
  /// @env IBCTL_TWOFA_STABLE_SECS
  stableSecs: UInt = 300

  /// Does a scheduled cold restart preempt WaitingForHitl2fa?
  /// true  — cold restart wins; exit HITL, run restart, re-enter login (default)
  /// false — cold restart deferred until HITL exits via its normal path
  /// @env IBCTL_TWOFA_COLD_RESTART_PREEMPTS_HITL
  coldRestartPreemptsHitl: Boolean = true

  /// If the initial ntfy push fails (network blip, ntfy server down), how many
  /// times to retry the send on subsequent scheduled-retry wakeups. 0 = give up
  /// silently. Only meaningful when strategy includes ntfy_callback.
  /// @env IBCTL_TWOFA_NTFY_SEND_RETRIES
  ntfySendRetries: UInt = 1
}

typealias TwoFaOnTimeout = "restart_then_hitl" | "restart_forever" | "hitl_immediately"
typealias HitlStrategy = "disabled" | "periodic" | "ntfy_callback" | "both"
typealias CounterResetScope = "any_reach" | "stable"

/// Gateway/TWS installation and port settings.
class GatewayConfig {
  /// Path to the TWS/Gateway installation directory.
  /// @env TWS_PATH
  twsPath: String = "/home/ibgateway/Jts"

  /// Settings storage path; empty = use twsPath. The recovery-marker persistence
  /// layer writes here — ensure Jts_live and Jts_paper live on a persistent volume.
  /// @env TWS_SETTINGS_PATH
  twsSettingsPath: String = ""

  /// Gateway/TWS major version. Auto-detected from the installation if empty.
  /// @env TWS_MAJOR_VRSN
  twsMajorVrsn: String = ""

  /// JVM heap size in MB.
  /// @env JAVA_HEAP_SIZE
  javaHeapSize: UInt = 768

  /// Program type: "gateway" or "tws".
  /// @env GATEWAY_OR_TWS
  gatewayOrTws: GatewayProgram = "gateway"

  /// Gateway API port for live trading (Gateway listens here; default 4001).
  /// Paired with liveSocatPort which fronts external clients.
  liveApiPort: UInt16 = 4001

  /// Gateway API port for paper trading (Gateway listens here; default 4002).
  paperApiPort: UInt16 = 4002

  /// Socat forwarding port for live (external-facing; default 4003).
  /// External clients connect here; socat forwards to liveApiPort.
  liveSocatPort: UInt16 = 4003

  /// Socat forwarding port for paper (external-facing; default 4004).
  paperSocatPort: UInt16 = 4004
}

/// Session conflict handling and scheduled cold-restart window.
class SessionConfig {
  /// Session conflict action: "primary" | "secondary" | "primaryoverride".
  /// @env IBCTL_SESSION_ACTION
  action: SessionAction = "primary"

  /// Incoming API connection policy: "accept" | "reject" | "manual".
  /// @env IBCTL_ACCEPT_INCOMING
  acceptIncoming: AcceptIncoming = "accept"

  /// Cold restart time in "HH:MM" 24h format (e.g., "09:00"). Empty = disabled.
  /// Preflight enforces the format; hand-edits that violate it are rejected at boot.
  /// @env TWS_COLD_RESTART
  twsColdRestart: String = ""

  /// Cold restart day of week: 0=Sunday, 1=Monday, ..., 6=Saturday. Default 0 (Sunday).
  /// @env TWS_COLD_RESTART_DAY
  twsColdRestartDay: UInt8 = 0
}

/// IBC-compatible TCP command server.
class CommandServerConfig {
  /// Enable the IBC-compatible TCP command server (required for dashboard control).
  enabled: Boolean = false

  /// Live instance command server TCP port.
  /// @env IBCTL_COMMAND_PORT
  port: UInt16 = 7462

  /// Paper instance command server TCP port.
  paperPort: UInt16 = 7463

  /// TCP bind address for the command server.
  bindAddress: String = "0.0.0.0"

  /// IP allow-list for command access — CIDR-aware. Env var accepts comma-separated form.
  /// @env IBCTL_CONTROL_FROM
  controlFrom: Listing<String> = new Listing { "127.0.0.1"; "172.0.0.0/8" }
}

/// Java agent IPC settings.
/// Dual-mode socket paths (agent-live.sock, agent-paper.sock) are derived
/// by docker/entrypoint.sh at runtime, not configured here.
class AgentConfig {
  /// Unix domain socket path for Rust↔Java agent IPC.
  /// @env IBCTL_AGENT_SOCKET
  socketPath: String = "/run/ibctl/agent.sock"
}

/// Web dashboard settings (consumed by entrypoint + FastAPI, not by Rust directly).
/// Stored in TOML under [dashboard] — Rust ignores unknown sections via serde(flatten).
/// Auth secrets (OAuth client secrets, bearer tokens) are env-only — never in TOML.
class DashboardConfig {
  /// Enable the web dashboard. Starts the entrypoint FastAPI when true.
  /// @env IBCTL_DASHBOARD_ENABLED
  enabled: Boolean = false

  /// Dashboard HTTP port.
  /// @env IBCTL_DASHBOARD_PORT
  port: UInt16 = 8080

  /// Bearer token for API auth; empty = no auth. Secrets never go in TOML —
  /// set the actual token via IBCTL_DASHBOARD_TOKEN. The schema enforces
  /// length == 0 (env-only).
  /// @env IBCTL_DASHBOARD_TOKEN
  token: String(length == 0) = ""

  /// Enable dashboard debug endpoints.
  /// @env IBCTL_DEBUG_MODE
  debugMode: Boolean = false

  /// Enable GitHub OAuth login. Requires the IBCTL_GITHUB_OAUTH_CLIENT_ID and
  /// IBCTL_GITHUB_OAUTH_CLIENT_SECRET env vars (secrets are env-only).
  githubOauthEnabled: Boolean = false

  /// Enable generic OIDC/SSO login (Authentik, Keycloak, etc.). Requires
  /// IBCTL_OIDC_CLIENT_ID, IBCTL_OIDC_CLIENT_SECRET, and oidcIssuer.
  oidcEnabled: Boolean = false

  /// OIDC issuer URL (e.g. https://auth.example.com/application/o/ibctl/).
  /// @env IBCTL_OIDC_ISSUER
  oidcIssuer: String = ""

  /// OIDC scopes, space-separated.
  /// @env IBCTL_OIDC_SCOPES
  oidcScopes: String = "openid profile email"

  /// Enable notifications (ntfy, Slack, Telegram). Requires dashboard.enabled.
  /// @env IBCTL_NOTIFICATIONS_ENABLED
  notificationsEnabled: Boolean = false

  /// Notification delivery channel: "ntfy" | "slack" | "telegram".
  /// @env IBCTL_NOTIFICATION_CHANNEL
  notificationChannel: "ntfy"|"slack"|"telegram" = "ntfy"

  /// ZMQ PUB socket for external status subscribers. On by default when the
  /// dashboard is running; set false to disable.
  /// @env IBCTL_ZMQ_ENABLED
  zmqEnabled: Boolean = true

  /// ZMQ PUB socket TCP port.
  /// @env IBCTL_ZMQ_PORT
  zmqPort: UInt16 = 5556

  /// External URL used to build ntfy action-button callback targets
  /// (e.g. https://ibctl.example.com). Leave empty if the dashboard is only
  /// reachable from inside the LAN and HITL ntfy_callback is unused.
  /// @env IBCTL_DASHBOARD_EXTERNAL_URL
  externalUrl: String = ""
}

/// ibctl-side policy for IBSTATUS pushes (consumed by ibctl state machine).
/// Separate from IbSystemStatusConfig which is the dashboard-side scraper.
class IbStatusConfig {
  /// When the dashboard pushes IBSTATUS=unavailable, should ibctl interrupt
  /// an already-authenticated session? Default: false.
  ///
  /// IBSTATUS was designed as a retry-gate — if IBKR backends are unreachable,
  /// don't hammer them with login attempts. It was never meant to kill active
  /// sessions. The scraper can be wrong (CDN blips, slow page updates) and
  /// Gateway's own UI label is the authoritative "my session is healthy"
  /// signal — detected via label inspection in the revocation bus, not via
  /// the public status page.
  ///
  /// Set to true only to restore the historical behavior where any unavailable
  /// push transitions Connected → WaitingForIB. Only useful if you trust the
  /// scraper more than the Gateway UI label.
  kickActiveSession: Boolean = false
}

/// IB system status scraper settings (consumed by dashboard daemon).
class IbSystemStatusConfig {
  /// Enable IB system status monitoring (requires dashboard.enabled).
  enabled: Boolean = false

  /// Fail-open TTL: if no status update arrives within this period, assume
  /// IB is available. Prevents stale-scraper false negatives.
  ttlSeconds: UInt = 600

  /// Seconds between IB status page scrapes. Default 300 (5 min).
  checkIntervalSeconds: UInt = 300

  /// IB system status page URL.
  url: String = "https://www.interactivebrokers.com/en/software/systemStatus.php"

  /// Region filter for maintenance windows: "NA" | "EU" | "APAC".
  region: String = "NA"

  /// IB backend servers to reach via TCP probe as a liveness signal.
  backendHosts: Listing<String> = new Listing { "cdc1-hb1.ibllc.com"; "cdc1-hb2.ibllc.com" }

  /// CDN fallback host for the internet-connectivity ping check.
  fallbackHost: String = "interactivebrokers.com"

  /// Additional exchange keywords appended to the built-in list — alerts
  /// mentioning any of these are treated as non-blocking (e.g. "PAXOS,COINBASE").
  extraExchangeKeywords: Listing<String> = new Listing {}

  /// Additional benign phrases appended to the built-in list — alerts matching
  /// these are treated as non-blocking (e.g. "is resolved").
  extraBenignPhrases: Listing<String> = new Listing {}

  /// Additional blocking keywords appended to the built-in list — alerts matching
  /// these are forced to CRITICAL severity (e.g. "emergency").
  extraBlockingKeywords: Listing<String> = new Listing {}
}

/// Log output settings.
class LoggingConfig {
  /// Log level: "debug" | "info" | "warn" | "error".
  /// @env IBCTL_LOG_LEVEL
  level: LogLevel = "info"

  /// Directory for persistent log files; empty = stdout only (no file logging).
  /// @env IBCTL_LOG_DIR
  logDir: String = ""

  /// Use futures market session dates for log filenames instead of calendar dates.
  /// When true, log files roll at sessionReopenHour ET (default 18 = 6 PM);
  /// when false, files roll at midnight local time.
  /// @env IBCTL_FUTURES_SESSION_LOGGING
  futuresSessionLogging: Boolean = false

  /// Hour (0-23, US/Eastern) when the futures session reopens and the next
  /// trading day's log file begins. Only used when futuresSessionLogging = true.
  /// Default 18 (6 PM ET — CME futures reopen).
  /// @env IBCTL_SESSION_REOPEN_HOUR
  sessionReopenHour: UInt8 = 18
}

/// Timing knobs for UI automation and retry behavior.
class TimingConfig {
  /// Delay between UI actions in the config dialog (ms).
  uiTickMs: UInt = 100

  /// Java agent-side delay after each Swing action (ms).
  agentTickMs: UInt = 50

  /// Wait after clicking login button before checking for 2FA (ms).
  postLoginDelayMs: UInt = 1000

  /// Seconds of no popups before considering login complete (quiet threshold).
  popupQuietSecs: UInt = 5

  /// Max seconds to wait for popups before moving on.
  popupMaxWaitSecs: UInt = 30

  /// Pause after clicking login radio buttons (IB API, Paper Trading) (ms).
  loginRadioDelayMs: UInt = 100

  /// Seconds to wait for JVM graceful shutdown (SIGTERM) before escalating to SIGKILL.
  jvmShutdownTimeoutSecs: UInt = 5

  /// Seconds to wait for the login window to appear before giving up.
  /// 0 = wait indefinitely (useful for headless servers during IB maintenance).
  /// Default 120.
  /// @env IBCTL_LOGIN_TIMEOUT
  loginDialogTimeoutSecs: UInt = 120

  /// Seconds to wait before restarting the JVM after an error or failure.
  /// Gives Gateway time to self-recover from transient connection losses.
  /// Default 90.
  /// @env IBCTL_RESTART_DELAY
  restartDelaySecs: UInt = 90

  /// Max re-login attempts before cancelling and restarting the JVM. On first
  /// attempt, waits 30s then clicks Re-login; if it fails again (up to this
  /// limit), clicks Cancel and takes reloginFailureAction. 0 = always cancel.
  /// Default 1.
  /// @env IBCTL_RELOGIN_ATTEMPTS
  reloginMaxAttempts: UInt = 1

  /// Action after exhausting re-login attempts.
  ///   "reauth"  — re-use the existing login form without killing the JVM (default)
  ///   "restart" — kill and relaunch the JVM for a clean slate
  /// @env IBCTL_RELOGIN_FAILURE_ACTION
  reloginFailureAction: "reauth"|"restart" = "reauth"

  /// TCP probe interval to Gateway's API port during post-auth states.
  /// Ground-truth check for "is Gateway actually listening?" — independent of
  /// Swing UI labels. 0 = disabled (rely on label probe only).
  /// Range: 0 | 1..=3600 seconds.
  /// @env IBCTL_API_PORT_PROBE_INTERVAL_SECS
  apiPortProbeIntervalSecs: UInt = 5

  /// Consecutive TCP probe failures before firing ApiPortListenerLost revocation.
  /// Absorbs transient OS-level blips. Range: 1..=10.
  /// @env IBCTL_API_PORT_PROBE_FAILS_BEFORE_REVOKE
  apiPortProbeFailsBeforeRevoke: UInt = 3

  /// Three-phase reconnect recovery coordinator (Aggressive → Backoff → GivenUp).
  recovery: RecoveryTimingConfig = new RecoveryTimingConfig {}
}

/// [timing.recovery] — Aggressive → Backoff → GivenUp reconnect coordinator.
/// Mirrors ibctl/src/config.rs::RecoveryTimingConfig. Env overrides
/// (IBCTL_RECOVERY_*) layer on top in Rust's `to_runtime()`.
///
/// Bounds asymmetry note: giveupCallbackValidHours enforces 1..=168 in Pydantic
/// preflight only — Rust u32 and Pkl UInt accept the full range. Preflight is
/// the stricter gate, so a hand-edited TOML with giveup_callback_valid_hours=0
/// is blocked at boot instead of silently disabling the retry link.
class RecoveryTimingConfig {
  /// master enable — set false in TOML to disable the coordinator entirely
  /// without touching env. Env IBCTL_RECOVERY_DISABLED=1|true|yes wins if set.
  /// Default true.
  enabled: Boolean = true

  /// Aggressive → Backoff threshold (seconds). Default 3600 (1h).
  /// @env IBCTL_RECOVERY_AGGRESSIVE_MAX_SECS
  aggressivePhaseMaxSecs: UInt = 3600

  /// Backoff → GivenUp threshold (seconds). Default 10800 (3h).
  /// @env IBCTL_RECOVERY_BACKOFF_MAX_SECS
  backoffPhaseMaxSecs: UInt = 10800

  /// Sleep between Backoff retries (seconds). Default 900 (15 min).
  /// @env IBCTL_RECOVERY_BACKOFF_INTERVAL_SECS
  backoffIntervalSecs: UInt = 900

  /// Minimum Connected dwell to count as a success and reset the phase timer.
  /// Default 60. Guards against a 3-second flap-Connect resetting the timer
  /// indefinitely — the exact pathology this coordinator is meant to detect.
  /// @env IBCTL_RECOVERY_MIN_SUCCESS_DWELL_SECS
  minSuccessDwellSecs: UInt = 60

  /// same-error streak forcing HITL — skips time-based escalation and enters
  /// HITL immediately when the same error fingerprint recurs. Default 8
  /// (~40 min at 5-min cycles).
  /// @env IBCTL_RECOVERY_FINGERPRINT_STREAK
  fingerprintStreakForcingHitl: UInt = 8

  /// Coalescer key for the give-up ntfy alert. Distinct kind lets the
  /// dashboard's ntfy coalescer dedupe re-fires within the resend interval.
  giveupNtfyKind: String = "reconnect_gave_up"

  /// Signed retry-link validity window on the give-up alert (hours, 1..=168).
  /// Default 12 (matches the HITL 2FA callback convention).
  giveupCallbackValidHours: UInt = 12

  /// Minimum wall-clock interval before re-firing a give-up alert while the
  /// state machine is still parked in GivenUp (hours). Default 6.
  giveupAlertResendIntervalHours: UInt = 6
}

// --- Container Layer ---

/// Docker container settings (not consumed by Rust — used for Compose generation).
class ContainerConfig {
  /// Docker image name
  imageName: String = "ibctl"
  /// Docker image tag
  imageTag: String = "latest"
  /// Container name
  containerName: String = "ibctl-gateway"
  /// Restart policy
  restartPolicy: String = "unless-stopped"
  /// Enable VNC access
  enableVnc: Boolean = false
  /// VNC port
  vncPort: UInt16 = 5900
  /// noVNC websocket port
  noVncPort: UInt16 = 6080
  /// Enable dashboard in container
  enableDashboard: Boolean = false
  /// Dashboard port (mirrors runtime.dashboard.port)
  dashboardPort: UInt16 = 8080
}

// --- Compose Layer ---

/// Docker Compose service definition shape.
class ComposeConfig {
  /// Compose service name
  serviceName: String = "ib-gateway"
  /// Docker network name
  networkName: String = "ibctl-net"
  /// Expose live API port to host
  exposeLiveApi: Boolean = true
  /// Expose paper API port to host
  exposePaperApi: Boolean = true
  /// Expose live command server port
  exposeCommandServer: Boolean = true
  /// Expose paper command server port
  exposePaperCommandServer: Boolean = true
  /// Expose VNC port
  exposeVnc: Boolean = true
  /// Expose noVNC websocket port
  exposeNoVnc: Boolean = true
  /// Expose dashboard port
  exposeDashboard: Boolean = true
  /// Named volume for persistent state
  persistVolumeName: String = "ibctl-persist"
  /// Container mount point for persistent state
  persistMountPath: String = "/opt/ibctl/persist"
}
