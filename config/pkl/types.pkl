/// ibctl configuration schema.
///
/// This is the canonical type definition for the ibctl deployment model.
/// All generated config artifacts (TOML, Compose, .env) derive from this schema.
///
/// The runtime layer mirrors ibctl/src/config.rs structs exactly — the generated
/// TOML must satisfy the Rust parser.
module ibctl.types

// --- Module-level properties (amendable by base.pkl and profiles) ---

/// Human-readable project name
name: String = "ibctl"

/// Profile identifier (e.g., "live", "both", "dashboard")
profile: String = "base"

/// High-level deployment settings
deployment: Deployment = new Deployment {}

/// Runtime config — maps to ibctl.toml sections consumed by Rust
runtime: RuntimeConfig = new RuntimeConfig {}

/// Container/image settings for Docker deployment
container: ContainerConfig = new ContainerConfig {}

/// Docker Compose service definition shape
compose: ComposeConfig = new ComposeConfig {}

// --- Enums ---

typealias TradingMode = "live"|"paper"|"both"
typealias TotpProvider = "oathtool"|"builtin"
typealias TwoFaTimeoutAction = "restart"|"exit"
typealias GatewayProgram = "gateway"|"tws"
typealias SessionAction = "primary"|"secondary"|"primaryoverride"
typealias AcceptIncoming = "accept"|"reject"|"manual"
typealias SiteRole = "primary"|"standby"
typealias LogLevel = "debug"|"info"|"warn"|"error"

// --- Deployment Layer ---

/// High-level deployment identity — what kind of system is this?
class Deployment {
  tradingMode: TradingMode = "live"
  siteRole: SiteRole = "primary"
  autoLaunch: Boolean = true
  timezone: String = "America/New_York"
}

// --- Runtime Layer (mirrors config.rs) ---

class RuntimeConfig {
  auth: AuthConfig = new AuthConfig {}
  twofa: TwoFaConfig = new TwoFaConfig {}
  gateway: GatewayConfig = new GatewayConfig {}
  session: SessionConfig = new SessionConfig {}
  commandServer: CommandServerConfig = new CommandServerConfig {}
  agent: AgentConfig = new AgentConfig {}
  dashboard: DashboardConfig = new DashboardConfig {}
  ibSystemStatus: IbSystemStatusConfig = new IbSystemStatusConfig {}
  ibStatus: IbStatusConfig = new IbStatusConfig {}
  logging: LoggingConfig = new LoggingConfig {}
  timing: TimingConfig = new TimingConfig {}
}

/// Auth config. Passwords are env-only (TWS_PASSWORD, TWS_PASSWORD_FILE).
/// Only tws_userid and trading_mode appear in generated TOML.
class AuthConfig {
  /// IB login username — set via TWS_USERID env var, not in TOML
  /// Must be empty (env-only) or alphanumeric IB username
  /// @env TWS_USERID
  twsUserid: String(matches(Regex("^[a-zA-Z0-9_]*$"))) = ""
  /// Trading mode — also set via TRADING_MODE env var
  tradingMode: TradingMode = "paper"
  /// Paper account sub-config (for dual mode)
  paper: PaperAuthConfig = new PaperAuthConfig {}
}

class PaperAuthConfig {
  /// Paper account username — set via TWS_USERID_PAPER env var, not in TOML
  /// Must be empty (env-only) or alphanumeric IB username
  /// @env TWS_USERID_PAPER
  twsUserid: String(matches(Regex("^[a-zA-Z0-9_]*$"))) = ""
}

/// Two-factor authentication settings.
class TwoFaConfig {
  /// Name of env var holding the TOTP secret (must be an env var name, not a secret value)
  secretEnv: String(matches(Regex("^[A-Z][A-Z0-9_]*$"))) = "TWOFACTOR_CODE"
  /// TOTP provider (env: TOTP_PROVIDER)
  provider: TotpProvider = "oathtool"
  /// Action on 2FA timeout (env: TWOFA_TIMEOUT_ACTION)
  timeoutAction: TwoFaTimeoutAction = "restart"
  /// Max seconds to wait for 2FA approval.
  /// Rust code default is 180; base.pkl overrides to 120 for Docker deployment.
  /// @env TWOFA_EXIT_INTERVAL
  exitInterval: UInt = 180
  /// 2FA device name for selection dialog, empty = skip (env: TWOFA_DEVICE)
  device: String = ""
  /// Force re-login after 2FA timeout (env: RELOGIN_AFTER_TWOFA_TIMEOUT)
  reloginAfterTimeout: Boolean = false
  /// Human-in-the-loop 2FA backoff policy.
  backoff: TwoFaBackoffConfig = new TwoFaBackoffConfig {}
}

/// Policy for stopping the tight 2FA-restart loop after repeated failures
/// (operator asleep, unavailable). After `maxImmediateAttempts` consecutive
/// 2FA timeouts, ibctl enters WaitingForHitl2fa — a cooperative state that
/// either auto-retries on a schedule, waits for an operator ntfy callback,
/// or both. Prevents overnight IB Key prompt spam.
class TwoFaBackoffConfig {
  /// After this many consecutive 2FA timeouts, stop the tight restart loop.
  /// 0 = disabled (legacy behavior: loop forever).
  /// @env IBCTL_TWOFA_MAX_IMMEDIATE_ATTEMPTS
  maxImmediateAttempts: UInt = 3

  /// What to do when twofa.exitInterval fires.
  ///   "restart_then_hitl" — kill JVM, relaunch, count attempt; hit HITL on exhaustion (default)
  ///   "restart_forever"   — legacy pre-HITL behavior (never stop)
  ///   "hitl_immediately"  — first timeout goes straight to HITL (no restarts at all)
  /// @env IBCTL_TWOFA_ON_TIMEOUT
  onTimeout: TwoFaOnTimeout = "restart_then_hitl"

  /// HITL resume strategy. "disabled" = stay in HITL forever (dashboard still
  /// reflects state; operator must send HITL_RESUME manually via dashboard).
  /// @env IBCTL_TWOFA_STRATEGY
  strategy: HitlStrategy = "periodic"

  /// Retry cadence for periodic / both. Single value = constant. List =
  /// traverse then hold at last element. Must be non-empty for non-disabled
  /// strategies that include a timer.
  intervalsMinutes: Listing<UInt> = new Listing { 60 }

  /// Hours the signed ntfy-action URL stays valid. One-shot — redeemed on
  /// first successful click. 0 < value <= 168 (one week ceiling).
  /// @env IBCTL_TWOFA_CALLBACK_VALID_HOURS
  callbackValidHours: UInt = 12

  /// Counter-reset policy after a successful reach of Connected.
  ///   "any_reach" — reset as soon as Connected (default)
  ///   "stable"    — require Connected sustained for stableSecs before reset
  /// @env IBCTL_TWOFA_COUNTER_RESET
  counterReset: CounterResetScope = "any_reach"

  /// Seconds Connected must persist before resetting the attempt counter
  /// when counterReset = "stable". Ignored for "any_reach".
  /// @env IBCTL_TWOFA_STABLE_SECS
  stableSecs: UInt = 300

  /// Does a scheduled cold restart preempt WaitingForHitl2fa?
  /// true  — cold restart wins; exit HITL, run restart, re-enter login (default)
  /// false — cold restart deferred until HITL exits via its normal path
  /// @env IBCTL_TWOFA_COLD_RESTART_PREEMPTS_HITL
  coldRestartPreemptsHitl: Boolean = true

  /// If the initial ntfy push fails (network blip, ntfy server down), how many
  /// times to retry the send on subsequent scheduled-retry wakeups. 0 = give up.
  /// Only meaningful when strategy includes ntfy_callback.
  /// @env IBCTL_TWOFA_NTFY_SEND_RETRIES
  ntfySendRetries: UInt = 1
}

typealias TwoFaOnTimeout = "restart_then_hitl" | "restart_forever" | "hitl_immediately"
typealias HitlStrategy = "disabled" | "periodic" | "ntfy_callback" | "both"
typealias CounterResetScope = "any_reach" | "stable"

/// Gateway/TWS installation and port settings.
class GatewayConfig {
  /// Path to TWS/Gateway installation (env: TWS_PATH)
  twsPath: String = "/home/ibgateway/Jts"
  /// Settings storage path, empty = use twsPath
  /// @env TWS_SETTINGS_PATH
  twsSettingsPath: String = ""
  /// Gateway version, auto-detected if empty
  /// @env TWS_MAJOR_VRSN
  twsMajorVrsn: String = ""
  /// JVM heap size in MB
  /// @env JAVA_HEAP_SIZE
  javaHeapSize: UInt = 768
  /// Program type
  /// @env GATEWAY_OR_TWS
  gatewayOrTws: GatewayProgram = "gateway"
  /// Gateway API port for live (Gateway listens here)
  liveApiPort: UInt16 = 4001
  /// Gateway API port for paper
  paperApiPort: UInt16 = 4002
  /// Socat forwarding port for live (external-facing)
  liveSocatPort: UInt16 = 4003
  /// Socat forwarding port for paper
  paperSocatPort: UInt16 = 4004
}

/// Session conflict handling.
class SessionConfig {
  /// Session conflict action (env: IBCTL_SESSION_ACTION)
  action: SessionAction = "primary"
  /// Incoming API connection policy (env: IBCTL_ACCEPT_INCOMING)
  acceptIncoming: AcceptIncoming = "accept"
  /// Cold restart time "HH:MM" 24h format, empty = disabled
  /// @env TWS_COLD_RESTART
  twsColdRestart: String = ""
  /// Cold restart day of week (0=Sunday, 1=Monday, ..., 6=Saturday)
  /// @env TWS_COLD_RESTART_DAY
  twsColdRestartDay: UInt8 = 0
}

/// TCP command server (IBC-compatible).
class CommandServerConfig {
  /// Enable command server (required for dashboard)
  enabled: Boolean = false
  /// Live instance command server port (env: IBCTL_COMMAND_PORT)
  port: UInt16 = 7462
  /// Paper instance command server port
  paperPort: UInt16 = 7463
  /// Bind address
  bindAddress: String = "0.0.0.0"
  /// IP allow-list for command access (env: IBCTL_CONTROL_FROM, comma-separated)
  controlFrom: Listing<String> = new Listing { "127.0.0.1"; "172.0.0.0/8" }
}

/// Java agent IPC settings.
/// Dual-mode socket paths (agent-live.sock, agent-paper.sock) are derived
/// by docker/entrypoint.sh at runtime, not configured here.
class AgentConfig {
  /// Unix domain socket path (env: IBCTL_AGENT_SOCKET)
  socketPath: String = "/run/ibctl/agent.sock"
}

/// Web dashboard settings (consumed by entrypoint + FastAPI, not by Rust directly).
/// Stored in TOML under [dashboard] — Rust ignores unknown sections via serde(flatten).
/// Auth secrets (OAuth client secrets, tokens) are env-only — never stored in TOML.
class DashboardConfig {
  /// Enable dashboard (env: IBCTL_DASHBOARD_ENABLED)
  enabled: Boolean = false
  /// Dashboard HTTP port (env: IBCTL_DASHBOARD_PORT)
  port: UInt16 = 8080
  /// Bearer token for API auth, empty = no auth
  /// Secrets never go in TOML — set via IBCTL_DASHBOARD_TOKEN env var
  /// Must be empty in schema (actual token is env-only)
  token: String(length == 0) = ""
  /// Enable debug endpoints (env: IBCTL_DEBUG_MODE)
  debugMode: Boolean = false
  /// Enable GitHub OAuth login (requires IBCTL_GITHUB_OAUTH_CLIENT_ID + _CLIENT_SECRET env vars)
  githubOauthEnabled: Boolean = false
  /// Enable generic OIDC/SSO login (Authentik, Keycloak, etc.)
  /// Requires IBCTL_OIDC_CLIENT_ID + _CLIENT_SECRET + oidcIssuer
  oidcEnabled: Boolean = false
  /// OIDC issuer URL (e.g. https://auth.example.com/application/o/ibctl/)
  /// @env IBCTL_OIDC_ISSUER
  oidcIssuer: String = ""
  /// OIDC scopes (space-separated)
  /// @env IBCTL_OIDC_SCOPES
  oidcScopes: String = "openid profile email"
  /// Enable notifications (ntfy, Slack, Telegram)
  /// @env IBCTL_NOTIFICATIONS_ENABLED
  notificationsEnabled: Boolean = false
  /// Notification delivery channel: "ntfy", "slack", or "telegram"
  /// @env IBCTL_NOTIFICATION_CHANNEL
  notificationChannel: "ntfy"|"slack"|"telegram" = "ntfy"
  /// ZMQ PUB socket for external status subscribers
  /// Always on when dashboard is running. Set to false to disable.
  /// @env IBCTL_ZMQ_ENABLED
  zmqEnabled: Boolean = true
  /// ZMQ PUB socket port
  /// @env IBCTL_ZMQ_PORT
  zmqPort: UInt16 = 5556
}

/// ibctl-side policy for IBSTATUS pushes (consumed by ibctl state machine).
/// Separate from IbSystemStatusConfig which is the dashboard-side scraper.
class IbStatusConfig {
  /// When the dashboard pushes IBSTATUS=unavailable, should ibctl interrupt
  /// an already-authenticated session? Default: false.
  ///
  /// IBSTATUS was designed as a retry-gate — if IBKR backends are unreachable,
  /// don't hammer them with login attempts. It was never meant to kill active
  /// sessions. The scraper can be wrong (CDN blips, slow page updates) and
  /// Gateway's own UI label is the authoritative "my session is healthy"
  /// signal — detected via label inspection in the revocation bus, not via
  /// the public status page.
  ///
  /// Set to true only to restore the historical behavior where any unavailable
  /// push transitions Connected → WaitingForIB.
  kickActiveSession: Boolean = false
}

/// IB system status scraper settings (consumed by dashboard daemon).
class IbSystemStatusConfig {
  /// Enable status monitoring (requires dashboard)
  enabled: Boolean = false
  /// Fail-open TTL: assume available if no update within this period
  ttlSeconds: UInt = 600
  /// Seconds between IB status page scrapes
  checkIntervalSeconds: UInt = 300
  /// IB status page URL
  url: String = "https://www.interactivebrokers.com/en/software/systemStatus.php"
  /// Region filter: "NA", "EU", or "APAC"
  region: String = "NA"
  /// IB backend servers for ICMP checks
  backendHosts: Listing<String> = new Listing { "cdc1-hb1.ibllc.com"; "cdc1-hb2.ibllc.com" }
  /// CDN fallback for internet connectivity check
  fallbackHost: String = "interactivebrokers.com"
  /// Additional exchange keywords (non-blocking alerts)
  extraExchangeKeywords: Listing<String> = new Listing {}
  /// Additional benign phrases (non-blocking alerts)
  extraBenignPhrases: Listing<String> = new Listing {}
  /// Additional blocking keywords (force CRITICAL severity)
  extraBlockingKeywords: Listing<String> = new Listing {}
}

/// Log output settings.
class LoggingConfig {
  /// Log level (env: IBCTL_LOG_LEVEL)
  level: LogLevel = "info"
  /// Directory for persistent log files, empty = stdout only (env: IBCTL_LOG_DIR)
  logDir: String = ""
  /// Use futures market session dates for log filenames (env: IBCTL_FUTURES_SESSION_LOGGING)
  futuresSessionLogging: Boolean = false
  /// Hour (0-23 ET) when futures session reopens (env: IBCTL_SESSION_REOPEN_HOUR)
  sessionReopenHour: UInt8 = 18
}

/// Timing knobs for UI automation and retry behavior.
class TimingConfig {
  /// Delay between UI actions in config dialog (ms)
  uiTickMs: UInt = 100
  /// Java agent delay after each Swing action (ms)
  agentTickMs: UInt = 50
  /// Wait after login button before checking for 2FA (ms)
  postLoginDelayMs: UInt = 1000
  /// Seconds of no popups before considering login complete
  popupQuietSecs: UInt = 5
  /// Max seconds to wait for popups
  popupMaxWaitSecs: UInt = 30
  /// Pause after selecting radio buttons on login screen (ms)
  loginRadioDelayMs: UInt = 100
  /// SIGTERM wait before SIGKILL (seconds)
  jvmShutdownTimeoutSecs: UInt = 5
  /// Seconds to wait for login window (0 = indefinite, env: IBCTL_LOGIN_TIMEOUT)
  loginDialogTimeoutSecs: UInt = 120
  /// Seconds to wait before restarting JVM after failure (env: IBCTL_RESTART_DELAY)
  restartDelaySecs: UInt = 90
  /// Max re-login attempts before cancel + restart (env: IBCTL_RELOGIN_ATTEMPTS)
  reloginMaxAttempts: UInt = 1
  /// Action after exhausting re-login attempts: "reauth" re-uses the login form,
  /// "restart" kills and relaunches the JVM. (env: IBCTL_RELOGIN_FAILURE_ACTION)
  reloginFailureAction: "reauth"|"restart" = "reauth"

  /// TCP probe interval to Gateway's API port during post-auth states. Ground-
  /// truth check for "is Gateway actually listening?" — independent of Swing
  /// UI labels. 0 = disabled; rely on label probe + other revocation sources.
  /// Range: 0 | 1..=3600 seconds.
  /// @env IBCTL_API_PORT_PROBE_INTERVAL_SECS
  apiPortProbeIntervalSecs: UInt = 5

  /// Consecutive TCP probe failures before firing ApiPortListenerLost revocation.
  /// Absorbs transient OS-level blips. Range: 1..=10.
  /// @env IBCTL_API_PORT_PROBE_FAILS_BEFORE_REVOKE
  apiPortProbeFailsBeforeRevoke: UInt = 3
}

// --- Container Layer ---

/// Docker container settings (not consumed by Rust — used for Compose generation).
class ContainerConfig {
  /// Docker image name
  imageName: String = "ibctl"
  /// Docker image tag
  imageTag: String = "latest"
  /// Container name
  containerName: String = "ibctl-gateway"
  /// Restart policy
  restartPolicy: String = "unless-stopped"
  /// Enable VNC access
  enableVnc: Boolean = false
  /// VNC port
  vncPort: UInt16 = 5900
  /// noVNC websocket port
  noVncPort: UInt16 = 6080
  /// Enable dashboard in container
  enableDashboard: Boolean = false
  /// Dashboard port (mirrors runtime.dashboard.port)
  dashboardPort: UInt16 = 8080
}

// --- Compose Layer ---

/// Docker Compose service definition shape.
class ComposeConfig {
  /// Compose service name
  serviceName: String = "ib-gateway"
  /// Docker network name
  networkName: String = "ibctl-net"
  /// Expose live API port to host
  exposeLiveApi: Boolean = true
  /// Expose paper API port to host
  exposePaperApi: Boolean = true
  /// Expose live command server port
  exposeCommandServer: Boolean = true
  /// Expose paper command server port
  exposePaperCommandServer: Boolean = true
  /// Expose VNC port
  exposeVnc: Boolean = true
  /// Expose noVNC websocket port
  exposeNoVnc: Boolean = true
  /// Expose dashboard port
  exposeDashboard: Boolean = true
  /// Named volume for persistent state
  persistVolumeName: String = "ibctl-persist"
  /// Container mount point for persistent state
  persistMountPath: String = "/opt/ibctl/persist"
}
